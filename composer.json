{
  "name": "attaching/attachment",
  "description": "Attaching process app",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-fileinfo": "*",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "doctrine/dbal": "^4.3",
    "doctrine/orm": "^3.3",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/event-dispatcher": "^8.1",
    "symfony/filesystem": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/mime": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "fakerphp/faker": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.75",
    "gating/gate": "dev-master",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/panther": "^2.4",
    "symfony/test-pack": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "App\\Attaching\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Attaching\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --verbose",
    "phpstan": "phpstan analyse",
    "test": "phpunit",
    "test:coverage": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text=var/coverage-summary.txt",
    "schema:parity": [
      "@php bin/console doctrine:migrations:migrate --no-interaction --env=prod",
      "@php bin/console doctrine:migrations:up-to-date --env=prod",
      "@php bin/console doctrine:schema:validate --env=prod"
    ],
    "gate": "@php vendor/bin/gating check --target=.",
    "quality": [
      "@cs:check",
      "@phpstan",
      "@test",
      "@gate"
    ]
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/collectioning.git"
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/objecting.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/tabling-.git"
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}

